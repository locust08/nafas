# Set only after the production website origin is confirmed.
# NAFAS_SITE_URL=https://your-confirmed-domain
# Optional existing visitor service endpoint. Return {"month":"YYYY-MM","count":123}.
# NAFAS_MONTHLY_VISITORS_ENDPOINT=https://your-confirmed-visitor-service
# Confirmed WhatsApp number, digits only, when supplied.
# NAFAS_WHATSAPP_NUMBER=

# Optional CMS JSON feed for posters and reports; see docs/research/education-cms.md.
# NAFAS_EDUCATION_CONTENT_URL=https://your-cms.example/nafas/education
# Optional English CMS copy, using the same Malay image URLs.
# NAFAS_EDUCATION_CONTENT_URL_EN=https://your-cms.example/nafas/education/en
